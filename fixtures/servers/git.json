{
 "server": "git",
 "transport": "stdio",
 "command": "uvx",
 "args": [
  "mcp-server-git"
 ],
 "source": "hand-transcribed snapshot of the server's public tools/list (abbreviated); refresh with `toolgraph capture`",
 "tools": [
  {
   "name": "git_status",
   "description": "Shows the working tree status",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     }
    },
    "required": [
     "repo_path"
    ]
   }
  },
  {
   "name": "git_diff_unstaged",
   "description": "Shows changes in the working directory that are not yet staged. Returns a diff",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "context_lines": {
      "type": "number",
      "description": "context_lines"
     }
    },
    "required": [
     "repo_path"
    ]
   }
  },
  {
   "name": "git_diff_staged",
   "description": "Shows changes that are staged for commit. Returns a diff",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "context_lines": {
      "type": "number",
      "description": "context_lines"
     }
    },
    "required": [
     "repo_path"
    ]
   }
  },
  {
   "name": "git_diff",
   "description": "Shows differences between branches or commits. Returns a diff",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "target": {
      "type": "string",
      "description": "target"
     },
     "context_lines": {
      "type": "number",
      "description": "context_lines"
     }
    },
    "required": [
     "repo_path",
     "target"
    ]
   }
  },
  {
   "name": "git_commit",
   "description": "Records changes to the repository. Returns the commit",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "message": {
      "type": "string",
      "description": "message"
     }
    },
    "required": [
     "repo_path",
     "message"
    ]
   }
  },
  {
   "name": "git_add",
   "description": "Adds file contents to the staging area",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "files": {
      "type": "array",
      "description": "files"
     }
    },
    "required": [
     "repo_path",
     "files"
    ]
   }
  },
  {
   "name": "git_reset",
   "description": "Unstages all staged changes",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     }
    },
    "required": [
     "repo_path"
    ]
   }
  },
  {
   "name": "git_log",
   "description": "Shows the commit logs. Returns commits",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "max_count": {
      "type": "number",
      "description": "max_count"
     }
    },
    "required": [
     "repo_path"
    ]
   }
  },
  {
   "name": "git_create_branch",
   "description": "Creates a new branch from an optional base branch. Returns the branch",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "branch_name": {
      "type": "string",
      "description": "branch_name"
     },
     "base_branch": {
      "type": "string",
      "description": "base_branch"
     }
    },
    "required": [
     "repo_path",
     "branch_name"
    ]
   }
  },
  {
   "name": "git_checkout",
   "description": "Switches branches",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "branch_name": {
      "type": "string",
      "description": "branch_name"
     }
    },
    "required": [
     "repo_path",
     "branch_name"
    ]
   }
  },
  {
   "name": "git_show",
   "description": "Shows the contents of a commit",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "revision": {
      "type": "string",
      "description": "revision"
     }
    },
    "required": [
     "repo_path",
     "revision"
    ]
   }
  },
  {
   "name": "git_branch",
   "description": "List Git branches. Returns branches",
   "inputSchema": {
    "type": "object",
    "properties": {
     "repo_path": {
      "type": "string",
      "description": "Path to the local git repository"
     },
     "branch_type": {
      "type": "string",
      "description": "branch_type"
     }
    },
    "required": [
     "repo_path",
     "branch_type"
    ]
   }
  }
 ]
}