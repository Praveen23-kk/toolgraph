{
  "mcpServers": {
    "github": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"], "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "<set-me>"}},
    "filesystem": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]},
    "git": {"type": "stdio", "command": "uvx", "args": ["mcp-server-git"]},
    "slack": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-slack"]},
    "playwright": {"type": "stdio", "command": "npx", "args": ["-y", "@playwright/mcp@latest"]},
    "context7": {"type": "stdio", "command": "npx", "args": ["-y", "@upstash/context7-mcp"]},
    "fetch": {"type": "stdio", "command": "uvx", "args": ["mcp-server-fetch"]},
    "memory": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory"]}
  },
  "projects": {
    "~/work/shop-api": {
      "mcpServers": {
        "postgres": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/shop"]}
      },
      "disabledMcpServers": ["memory"]
    },
    "~/work/data-graph": {
      "mcpServers": {},
      "disabledMcpServers": []
    }
  }
}
