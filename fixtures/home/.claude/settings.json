{
  "permissions": {"allow": ["mcp__github__get_file_contents", "Bash(git status)"]},
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python ~/.claude/hooks/block_rm_rf.py"}]},
      {"matcher": "mcp__github__push_files|mcp__github__create_or_update_file", "hooks": [{"type": "command", "command": "gitleaks protect --staged"}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|mcp__filesystem__write_file|mcp__filesystem__edit_file", "hooks": [{"type": "command", "command": "prettier --write \"$CLAUDE_FILE_PATH\""}]},
      {"matcher": "mcp__linear__.*", "hooks": [{"type": "command", "command": "python ~/.claude/hooks/sync_linear.py"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "notify-send 'Claude finished'"}]}
    ]
  }
}
